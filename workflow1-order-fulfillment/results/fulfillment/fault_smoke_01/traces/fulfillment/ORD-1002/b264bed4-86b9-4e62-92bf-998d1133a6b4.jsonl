 {"properties": {"order_id": {"title": "Order Id", "type": "string"}, "decision": {"enum": ["approve_fulfillment", "reject_insufficient_stock", "reject_shipping_constraint"], "title": "Decision", "type": "string"}, "reason": {"title": "Reason", "type": "string"}, "subtotal_usd": {"minimum": 0, "title": "Subtotal Usd", "type": "number"}, "shipping_service": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Shipping Service"}, "total_weight_kg": {"anyOf": [{"minimum": 0, "type": "number"}, {"type": "null"}], "default": null, "title": "Total Weight Kg"}, "shipping_usd": {"anyOf": [{"minimum": 0, "type": "number"}, {"type": "null"}], "default": null, "title": "Shipping Usd"}, "total_usd": {"anyOf": [{"minimum": 0, "type": "number"}, {"type": "null"}], "default": null, "title": "Total Usd"}}, "required": ["order_id", "decision", "reason", "subtotal_usd"], "title": "FulfillmentPlan", "type": "object"}}}
