{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "latest_answer_quality",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "semantic_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN",
        "UNREVIEWED",
        "DATA_ISSUE"
      ]
    },
    "run_status": {
      "type": "string"
    },
    "missing_helper_issues": {
      "type": "array"
    },
    "all_latest_outputs_reviewed": {
      "type": "boolean"
    },
    "latest_item_keys": {
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "semantic_verdict",
    "run_status",
    "missing_helper_issues",
    "all_latest_outputs_reviewed",
    "latest_item_keys"
  ]
}