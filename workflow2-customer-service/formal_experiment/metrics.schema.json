{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metrics",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "run_status": {
      "type": "string"
    },
    "eligibility": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "skip_reasons": {
      "type": [
        "array",
        "null"
      ]
    },
    "mutation_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "router_receipt": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "repeated_helper_calls": {
      "type": "integer",
      "minimum": 0
    },
    "repeated_tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "affected_stages": {
      "type": "array"
    },
    "subsequent_unresolved_work": {
      "type": "array"
    },
    "ledger_completion": {
      "type": [
        "string",
        "null"
      ]
    },
    "iterations": {
      "type": [
        "integer",
        "null"
      ]
    },
    "model_calls": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "provider_tokens": {
      "type": "object"
    },
    "elapsed_seconds": {
      "type": "number"
    },
    "error_type": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "run_id",
    "case_id",
    "condition",
    "run_status"
  ],
  "additionalProperties": true
}