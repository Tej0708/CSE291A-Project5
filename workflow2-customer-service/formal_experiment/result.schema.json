{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "condition": {
      "enum": [
        "clean",
        "fault"
      ]
    },
    "run_status": {
      "enum": [
        "completed",
        "error"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "eligible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "actual_mutation_count": {
      "type": "integer",
      "minimum": 0
    },
    "skip_reasons": {
      "type": "array"
    },
    "effective_consumed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "events": {
      "type": "array"
    },
    "injection_boundaries": {
      "type": "array"
    },
    "drafts": {
      "type": "array"
    },
    "qa_snapshots": {
      "type": "array"
    },
    "model_calls": {
      "type": "integer",
      "minimum": 0
    },
    "helper_calls": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "usage_records": {
      "type": "array"
    },
    "provider_tokens": {
      "type": "object"
    },
    "elapsed_seconds": {
      "type": "number"
    },
    "error_type": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "condition",
    "run_status",
    "result",
    "model_calls",
    "tool_calls",
    "helper_calls",
    "usage_records",
    "provider_tokens",
    "drafts",
    "qa_snapshots",
    "injection_boundaries",
    "elapsed_seconds"
  ],
  "additionalProperties": true
}