{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "previous_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "issue": {
      "type": [
        "string",
        "null"
      ]
    },
    "call_id": {
      "type": "string"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "run_id",
    "event_id",
    "event",
    "depends_on",
    "stage",
    "iteration",
    "issue",
    "elapsed_seconds"
  ],
  "additionalProperties": true
}